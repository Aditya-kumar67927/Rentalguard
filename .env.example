# Copy to .env and adjust. Never commit the real .env file.

# development | production | testing
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave empty for local SQLite (instance/rentalguard.db). PostgreSQL example:
# DATABASE_URL=postgresql://rentalguard:rentalguard@localhost:5432/rentalguard
DATABASE_URL=

# Salt used to pseudonymise contact identifiers (must match the salt used by scripts/clean_data.py)
RG_DATASET_SALT=rentalguard-dataset-v1

# Where trained artifacts live
MODEL_DIR=ml_models
LOAD_ML=true

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional: only seed the first N dataset listings (faster first start)
SEED_LIMIT=
